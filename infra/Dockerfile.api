FROM ghcr.io/astral-sh/uv:0.13.6 AS uv

FROM python:3.12-slim AS api
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_PYTHON_DOWNLOADS=never PATH="/app/.venv/bin:$PATH"
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY backend/src ./src
RUN uv sync --frozen --no-dev --no-editable
COPY backend/alembic.ini .
COPY backend/alembic ./alembic
COPY backend/tests/integration/demo_seed.py ./tests/integration/demo_seed.py
RUN useradd --system --no-create-home ips
USER ips
CMD ["sh", "-ec", "alembic upgrade head && exec uvicorn ips.main:app --host 0.0.0.0 --port 8000"]

FROM node:24-alpine AS frontend
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY apps/widget/package.json apps/widget/
COPY packages/api-client/package.json packages/api-client/
RUN npm ci
COPY apps/web/*.html apps/web/
COPY apps/widget/*.html apps/widget/*.ts apps/widget/
COPY apps/web/src apps/web/src
COPY apps/widget/src apps/widget/src
COPY packages/api-client/src packages/api-client/src
ARG API_ORIGIN=http://localhost:8000
ARG WIDGET_ORIGIN=http://localhost:5174
RUN VITE_API_BASE_URL="$API_ORIGIN" VITE_WIDGET_ORIGIN="$WIDGET_ORIGIN" npm run build

FROM nginx:stable-alpine AS web
COPY --from=frontend /app/apps/web/dist/ /usr/share/nginx/html/
RUN printf '%s\n' 'server {' '  listen 80;' '  root /usr/share/nginx/html;' \
    '  location /assets/ { try_files $uri =404; }' \
    '  location / { try_files $uri $uri/ /index.html; }' '}' > /etc/nginx/conf.d/default.conf

FROM nginx:stable-alpine AS widget
COPY --from=frontend /app/apps/widget/dist/ /usr/share/nginx/html/
