{
  "name": "ips-support-ai",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:web": "npm run dev -w @ips/web",
    "dev:widget": "npm run dev -w @ips/widget",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps",
    "build": "npm run build -w @ips/web && npm run build -w @ips/widget"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
