# Будущая конфигурация; envloader появится в B01. Это не настоящие секреты.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://ips:ips@localhost:5432/ips
WEB_ORIGIN=http://localhost:5173
WIDGET_ORIGIN=http://localhost:5174
COOKIE_SECURE=false
SESSION_SECRET=REPLACE_WITH_LOCAL_RANDOM_VALUE
CUSTOMER_TOKEN_SECRET=REPLACE_WITH_ANOTHER_LOCAL_RANDOM_VALUE
AI_PROVIDER=fake
AI_RUNNER_ENABLED=false
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=700
AI_TENANT_DAILY_REQUESTS=100
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=support@example.invalid
# Для внешнего SMTP настроить starttls (обычно 587) или implicit (обычно 465).
SMTP_TLS=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10
UPLOAD_DIR=./uploads
# Не добавлять AI_API_KEY/SESSION_SECRET в VITE_*: эти значения видит браузер.
